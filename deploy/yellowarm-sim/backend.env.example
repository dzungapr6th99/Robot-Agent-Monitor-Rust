# Source the ROS 2 distribution and generated Rust interface workspace first.
# Paths below are relative to the Rust workspace root. Export these variables.
ROS_ENABLED=true
ROS_DOMAIN_ID=0
ROS_NAMESPACE=/
ROS_LOCALHOST_ONLY=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
ROS_TOPICS_FILE=deploy/yellowarm-sim/ros-topics.json
# ROBOT_CONFIGURATION_ID=<matching database configuration, optional>
# ROBOT_AGENT_DATABASE=/absolute/path/to/robot-agent.db
# URDF_DATA_ROOT=/absolute/path/to/robot-assets
